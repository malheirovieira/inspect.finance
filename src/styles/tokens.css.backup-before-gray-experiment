/**
 * Design tokens — inspect.finance
 * CSS Custom Properties centralizadas (ADR-005: base para dark mode no V2 —
 * hoje só o tema claro é definido, mas toda a UI consome variáveis, nunca cores fixas).
 * Valores em HSL "H S% L%" (sem hsl()) para uso com hsl(var(--x) / <alpha-value>) no Tailwind.
 */

:root {
  /* ---- Paleta bruta (referência de marca) ---- */
  --cream: 45 67% 95%; /* #FBF7EB — fundo da landing/login */
  --charcoal: 45 5% 17%; /* #2D2C29 — texto/contraste da landing */
  --neon: 66 100% 48%; /* #DBF400 — acento da landing (NUNCA usar dentro do app) */
  --emerald: 163 100% 33%; /* #00A878 — acento do interior do app */

  /* ---- Tokens semânticos (interior do app — estética XP/Itaú: clean, profissional) ---- */
  --background: 0 0% 100%;
  --foreground: var(--charcoal);

  --card: 0 0% 100%;
  --card-foreground: var(--charcoal);

  --primary: var(--emerald);
  --primary-foreground: 0 0% 100%;

  --secondary: 210 20% 96%;
  --secondary-foreground: var(--charcoal);

  --muted: 210 16% 93%;
  --muted-foreground: 215 10% 45%;

  --accent: 163 55% 94%;
  --accent-foreground: 163 100% 22%;

  --destructive: 0 72% 51%;
  --destructive-foreground: 0 0% 100%;

  --border: 214 15% 89%;
  --input: 214 15% 89%;
  --ring: var(--emerald);

  --radius: 0.75rem;

  /* ---- Tipografia ---- */
  --font-heading: 'Playfair Display', serif;
  --font-body: 'Inter', sans-serif;

  /* ---- Espaçamento ---- */
  --spacing-xs: 0.5rem;
  --spacing-sm: 0.75rem;
  --spacing-md: 1.5rem;
  --spacing-lg: 2.5rem;
  --spacing-xl: 4rem;
  --spacing-2xl: 6rem;

  /* ---- Landing page (identidade visual Solidroad) — ver src/pages/LandingPage.tsx.
     Paleta dedicada à landing, independente dos tokens acima (que seguem
     alimentando login/cadastro e o interior do app). ---- */
  --color-bg-dark: #0a0a0a;
  --color-bg-white: #ffffff;
  --color-bg-light: #faf0e8;
  --color-bg-green-dark: #1e2a0e;
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #6b6b6b;
  --color-text-faded: #cccccc;
  --color-text-white: #ffffff;
  --color-accent: #ccff00;
  --color-label-green: #5a7a3a;
  --color-border: #e5e5e5;
}
